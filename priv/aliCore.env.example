# Injected into aliCore Port subprocess via alConfig:core_port_env/0
ALI_ROOT=.
ALI_INDEX_DIR=priv/index/tantivy
ALI_INDEX_IGNORE=_build,deps,.git,target,priv/bin,priv/index
ALI_INDEX_EXTENSIONS=erl,hrl,cfg,c,h,cc,cpp,hpp,rs
ALI_QDRANT_URL=http://127.0.0.1:6333

# LLM（对话）— 与 aliCfg.cfg 中 llm 段一致
# 百炼/通义：把 Key 赋给 ALI_LLM_API_KEY（或先 export DASHSCOPE_API_KEY 再同步）
ALI_LLM_API_KEY=
# DASHSCOPE_API_KEY=

# 可选：语义向量（DeepSeek 无此接口，需另配 OpenAI/硅基等 embedding 服务）
# ALI_EMBEDDING_BASE_URL=https://api.openai.com/v1/embeddings
# ALI_EMBEDDING_MODEL=text-embedding-3-small

# 可选：搜索结果二次排序（DeepSeek 无此接口）
# ALI_RERANK_BASE_URL=https://api.cohere.ai/v1/rerank
# ALI_RERANK_MODEL=rerank-english-v3.0

# 可选：向量库（非 LLM HTTP，本地 Qdrant 服务地址）
# ALI_QDRANT_URL=http://127.0.0.1:6333
