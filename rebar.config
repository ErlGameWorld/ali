{erl_opts, [debug_info, {i, "include"}]}.
{minimum_otp_vsn, "26"}.

{xref_checks, [
    undefined_function_calls,
    locals_not_used,
    deprecated_function_calls
]}.
{deps, [
    {erlfmt, "1.6.2"},
    {eWSrv, ".*", {git, "https://github.com/ErlGameWorld/eWSrv.git", {branch, "main"}}},
    {eWCli, ".*", {git, "https://github.com/ErlGameWorld/eWCli.git", {branch, "main"}}},
    {jiffy, ".*", {git, "https://github.com/ErlGameWorld/jiffy.git", {branch, "master"}}}
]}.

{shell, [
    {config, "config/sys.config"},
    {apps, [ali]}
]}.

%% 默认单测超时仅 5s（eunit DEFAULT_TEST_TIMEOUT）；NFS/冷启动 compiler 会超。
%% scale_timeouts 放大所有超时：24 × 5s = 120s。
{eunit_opts, [verbose, {scale_timeouts, 24}]}.

%% Also ensure jiffy.dll exists before ali compile (deps may already be marked compiled).
{pre_hooks, [
    {"(windows|win32)", compile, "powershell -ExecutionPolicy Bypass -File priv/scripts/build_core.ps1"},
    {"(linux|darwin|solaris|freebsd)", compile, "sh priv/scripts/build_core.sh"},
    {"(windows|win32)", clean, "powershell -ExecutionPolicy Bypass -File priv/scripts/stop_bins.ps1"},
    {"(linux|darwin|solaris|freebsd)", clean, "sh priv/scripts/stop_bins.sh"}
]}.

{relx, [
    {release, {ali, "0.1.0"}, [
        ali,
        sasl,
        runtime_tools,
        tools,
		syntax_tools,
		compiler
    ]},
    %% dev_mode=true 会在 lib/ 下建 Junction 指向 _build 与本机 OTP，
    %% Windows 下无法整目录复制到别处。默认 false：lib 为真实文件，可拷贝。
    {dev_mode, false},
    {include_erts, false},
	{system_libs, false},
    {extended_start_script, true},
    {overlay, [
        {mkdir, "config"},
        {copy, "config/aliCfg.cfg", "config/aliCfg.cfg"}
    ]}
]}.

%% dev：快速迭代（lib 为符号链接，勿复制 release 目录）
%% prod：自包含 release（含 ERTS），可整目录复制到任意路径运行
{profiles, [
    {dev, [
        {relx, [{dev_mode, true}]}
    ]},
    {prod, [
        {relx, [
            {dev_mode, false},
            {include_erts, true},
            {include_src, false},
            {debug_info, strip}
        ]}
    ]},
    {test, [
        {erl_opts, [debug_info, nowarn_export_all]}
    ]}
]}.

{ct_opts, [{dir, "test"}, {logdir, "logs/ct"}]}.

{dialyzer, [
    {warnings, [
        error_handling,
        unmatched_returns
    ]},
    {plt_apps, top_level_deps},
    {base_plt_apps, [erts, kernel, stdlib, sasl, runtime_tools, crypto, public_key, asn1, ssl, inets]},
    {plt_extra_apps, []},
    %% Exclude deps that may still lack abstract_code (hex/git without debug_info).
    {exclude_apps, [jiffy, erlfmt, quic]},
    {apps, [ali]}
]}.
